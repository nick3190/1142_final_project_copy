# Firebase Realtime Database（排行榜，選用；未設定時改走 /api/leaderboard）
# 例：https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Upstash Redis（Vercel 玩家存檔後端，部署時必填）
# 於 https://upstash.com 建立 Redis，並在 Vercel 專案 Settings → Environment Variables 填入
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
